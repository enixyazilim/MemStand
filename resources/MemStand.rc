#include <windows.h>
#include "resource.h"

// Icon
IDI_APP_ICON ICON "app.ico"

// Manifest
1 24 "app.manifest"

// Version Information
VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,1,0
PRODUCTVERSION  1,0,1,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
FILEFLAGS       VS_FF_DEBUG
#else
FILEFLAGS       0x0L
#endif
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Enix Yazılım"
            VALUE "FileDescription",  "MemStand - Smart Memory and Low-Latency Timer Manager"
            VALUE "FileVersion",      "1.0.1.0"
            VALUE "InternalName",     "MemStand"
            VALUE "LegalCopyright",   "Copyright (C) 2026 Enix Yazılım"
            VALUE "OriginalFilename", "MemStand.exe"
            VALUE "ProductName",      "MemStand"
            VALUE "ProductVersion",   "1.0.1.0"

        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
